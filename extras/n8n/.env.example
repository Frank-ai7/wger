# Public URL where Telegram can reach n8n (required for production).
# Examples:
#   https://n8n.example.com/
#   https://abc123.ngrok-free.app/
WEBHOOK_URL=http://localhost:5678/

# Host settings (must match WEBHOOK_URL)
N8N_HOST=localhost
N8N_PROTOCOL=http

# Timezone for scheduled tasks and date handling
GENERIC_TIMEZONE=Europe/Berlin

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string
