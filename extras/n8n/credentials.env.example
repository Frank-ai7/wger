# n8n owner account (local development defaults)
N8N_OWNER_EMAIL=admin@local.dev
N8N_OWNER_FIRST_NAME=Admin
N8N_OWNER_LAST_NAME=Local
N8N_OWNER_PASSWORD=Admin1234!

# API keys – fill in your own values, then run ./setup-credentials.sh
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Google Calendar ID (usually your Gmail address)
GOOGLE_CALENDAR_EMAIL=

# Optional: timezone
GENERIC_TIMEZONE=Europe/Berlin
